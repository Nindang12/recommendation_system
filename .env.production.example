# Mẫu tham chiếu — production thực tế dùng file .env ở thư mục gốc (xem deploy/README.md).

MONGO_URI=mongodb://admin:password@localhost:27017
MONGO_DB_NAME=rd_knowledge_graph
MONGO_USERNAME=admin
MONGO_PASSWORD=password

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=kg.events
RABBITMQ_EMBEDDING_QUEUE=embedding.jobs
RABBITMQ_EMBEDDING_ROUTING_KEY=embedding.jobs
RABBITMQ_EMBEDDING_DLQ=embedding.jobs.dlq

EMBEDDING_MODEL_NAME=graphsage_lite_v1
EMBEDDING_VERSION=1
EMBEDDING_DIMENSION=128
EMBEDDING_MAX_RETRY=3
EMBEDDING_RETRY_BACKOFF_SECONDS=30,120,600
EMBEDDING_RECOMPUTE_COOLDOWN_SECONDS=300
WORKER_HEARTBEAT_STALE_SECONDS=120

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:9002,http://localhost:3000
FRONTEND_URL=http://localhost:9002

APP_AUTH_SECRET=change-me
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=change-me
ROOT_ADMIN_NAME=System Root Admin

OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# Docker Linux: có thể cần INFRA_HOST=172.17.0.1
# INFRA_HOST=host.docker.internal

# Chỉ khi chạy thêm docker-compose.infra.yml:
# MONGO_URI=mongodb://admin:pass@mongodb:27017/rd_knowledge_graph?authSource=admin
# NEO4J_URI=neo4j://neo4j:7687
# REDIS_URL=redis://redis:6379/0
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
