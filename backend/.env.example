MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=rd_knowledge_graph
MONGO_USERNAME=
MONGO_PASSWORD=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002
FRONTEND_URL=http://localhost:9002

OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434

APP_AUTH_SECRET=dev-change-me
ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=Admin@123456
ROOT_ADMIN_NAME=System Root Admin

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=kg.events
RABBITMQ_EMBEDDING_QUEUE=embedding.jobs
RABBITMQ_EMBEDDING_ROUTING_KEY=embedding.jobs
RABBITMQ_EMBEDDING_DLQ=embedding.jobs.dlq

EMBEDDING_MODEL_NAME=graphsage_lite_v1
EMBEDDING_VERSION=1
EMBEDDING_DIMENSION=128
EMBEDDING_MAX_RETRY=3
EMBEDDING_RETRY_BACKOFF_SECONDS=30,120,600
EMBEDDING_RECOMPUTE_COOLDOWN_SECONDS=300
WORKER_HEARTBEAT_STALE_SECONDS=120

# Dev/eval only: allow hybrid fixture seed (scripts/seed_evaluation_hybrid_fixtures.py)
# Do not set on production — overwrites embedding on seed entity IDs.
EVALUATION_ALLOW_SEED=
